# DupTrace environment configuration.
#
# Copy this file to .env and fill in your own values:
#   PowerShell:    Copy-Item .env.example .env
#   macOS/Linux:   cp .env.example .env
#
# .env is gitignored; only this .env.example is tracked. NEVER commit a real
# API key or your .env file.

# MCP endpoint the server's agent connects to. DupTrace hosts the MCP server and
# the web app in the SAME process, so this points back at the local server's /mcp.
DUPTRACE_MCP_URL=http://127.0.0.1:3000/mcp

# ---------------------------------------------------------------------------
# Model provider — one of: gemini | openai-compatible | claude-cli
# ---------------------------------------------------------------------------
MODEL_PROVIDER=gemini

# --- gemini (default) ------------------------------------------------------
# Google Gemini via the generateContent REST API. Requires YOUR OWN API key from
# Google AI Studio (https://aistudio.google.com/apikey). The key is sent in the
# x-goog-api-key header and is never logged. Set MODEL_API_KEY only in your local
# .env — keep it empty here.
MODEL_NAME=gemini-3.1-flash-lite
MODEL_API_KEY=
# Comma-separated fallback models, tried in order when the primary fails
# TRANSIENTLY (model unavailable / rate-limited / 5xx / timeout). Permanent errors
# (invalid key, bad request) are not retried. Set empty to disable fallback.
MODEL_FALLBACK_MODELS=gemini-3.5-flash-lite

# --- openai-compatible (alternative) ---------------------------------------
# Set MODEL_PROVIDER=openai-compatible to use an OpenAI-compatible chat API.
# MODEL_API_KEY is sent as "Authorization: Bearer <key>", MODEL_NAME is the model
# id, and MODEL_BASE_URL is the API base URL. (MODEL_BASE_URL is ignored by gemini,
# which uses Google's fixed endpoint.)
MODEL_BASE_URL=https://api.openai.com/v1

# --- claude-cli (alternative) ----------------------------------------------
# Set MODEL_PROVIDER=claude-cli to drive a locally installed, authenticated Claude
# CLI (no API key needed). MODEL_CLI_COMMAND is the executable to invoke.
MODEL_CLI_COMMAND=claude

# ---------------------------------------------------------------------------
# Agent loop + timeouts
# ---------------------------------------------------------------------------
# Maximum model/tool loop iterations per investigation.
MAX_AGENT_STEPS=12
# MCP client call timeout, in milliseconds.
MCP_CLIENT_TIMEOUT_MS=10000
# Per-request model budget for the gemini and openai-compatible providers (ms).
MODEL_TIMEOUT_MS=60000
# claude-cli per-turn budget (ms) — the local CLI is much slower than a hosted API.
MODEL_CLI_TIMEOUT_MS=180000

# Hosted Vercel deployment only. Configure these in Vercel Project Settings →
# Environment Variables. Never commit real values or expose the internal token.
DUPTRACE_ACCESS_PASSWORD=
DUPTRACE_SESSION_SECRET=
DUPTRACE_INTERNAL_MCP_TOKEN=
